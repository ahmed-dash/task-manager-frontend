pipeline {
    agent any
    stages {
        stage('Lint') {
            steps {
                sh '''
                docker run --rm -v $WORKSPACE:/app -w /app node:20-alpine \
                  sh -c "npm ci && npm run lint"
                '''
            }
        }
        stage('Deploy') {
            steps {
                sh 'cd /opt/task-manager && docker compose -f docker-compose.prod.yml up -d --build frontend'
            }
        }
    }
}